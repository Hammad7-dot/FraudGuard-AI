# Copy to .env and adjust for your environment. Never commit the real .env file.

APP_NAME=FraudGuard AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# Use sqlite for quick local dev, or a Postgres DSN in production:
# postgresql+psycopg2://fraudguard:fraudguard@localhost:5432/fraudguard
DATABASE_URL=sqlite:///./fraudguard.db

REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=0.5

API_KEY=replace-with-a-private-development-key
REQUIRE_API_KEY=true
RATE_LIMIT_PER_MINUTE=120
TRUSTED_PROXY_IPS=["127.0.0.1","::1"]

RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
RISK_REVIEW_THRESHOLD=45

XGBOOST_MODEL_VERSION=1.0.0
ISOLATION_FOREST_MODEL_VERSION=1.0.0
MODEL_DIR=data/models
